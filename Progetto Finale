# Parte 2 – Importazione con Pandas #

df_importato = pd.read_csv("vendite.csv")
print(df_importato.head(5))
print(df_importato.shape)
df_importato.info()

# Parte 3 - Elaborazioni con Pandas #

df_importato["Incasso"] = df_importato["Quantità"] * df_importato["Prezzo_unitario"]
print(df_importato["Incasso"].head(3))

Incasso_totale = df_importato["Incasso"].sum()
print(f"Incasso totale = {Incasso_totale}")

Incasso_medio = df_importato.groupby("Negozio")["Incasso"].mean()
print(f"Incasso medio = {Incasso_medio}")

Raggruppamento_prodotto = df_importato.groupby("Prodotto")["Quantità"].sum().sort_values(ascending=False).head(3)
print(f"Raggruppamento per prodotto = {Raggruppamento_prodotto}")

Raggr_negozio_e_prodotto = df_importato.groupby(["Negozio", "Prodotto"])["Incasso"].mean()
print(f"Raggruppamento per Negozio e Prodotto = {Raggr_negozio_e_prodotto}")



# Parte 4 - Uso di NumPy #

import numpy as np

quantità_array = df_importato["Quantità"].to_numpy()
print(f"Quantità in Array = {quantità_array}")


# Parte 4.1 - Media, min, max, dev standard
quantità_media = np.mean(quantità_array)
print(f"Quantità media = {quantità_media}")

quantità_minima = np.min(quantità_array)
print(f"Quantità minima = {quantità_minima}")

quantità_massima = np.max(quantità_array)
print(f"Quantità massima = {quantità_massima}")

deviazione_standard = np.std(quantità_array)
print(f"Deviazione standard = {deviazione_standard}")

# Parte 4.2 - Quantità sopra la media #

quantità_sopra_media = quantità_array > quantità_media
num_quantità_sopra_media = quantità_sopra_media.sum()

# Parte 4.3 - Percentuale sopra la media #

percentuale_sopra_media = num_quantità_sopra_media / len(quantità_array) * 100
print(f"Percentuale sopra la media = {percentuale_sopra_media}")

# Parte 4.4 - Quantità prezzo unitario #

quantità_prezzo_unitario_array = df_importato[["Quantità", "Prezzo_unitario"]].to_numpy()
print(f"Quantità e prezzo unitario in Array = {quantità_prezzo_unitario_array}")


# 4.5 — calcolare l’incasso con NumPy e confrontarlo con la colonna Incasso #

quantità_numpy = quantità_prezzo_unitario_array[:, 0]
prezzo_numpy = quantità_prezzo_unitario_array[:, 1]

incasso_numpy = quantità_numpy * prezzo_numpy
print(f"Incasso numpy = {incasso_numpy}")

confronto_risultati_numpy_pandas = np.allclose(incasso_numpy, df_importato["Incasso"])
print(f"Confronto risultati numpy & pandas = {confronto_risultati_numpy_pandas}")


