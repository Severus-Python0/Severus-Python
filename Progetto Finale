# 6.0 - Analisi avanzata, nuova categoria, incasso totale per categoria, quantità media venduta #

def assegna_categoria(prodotto):
    if prodotto in ["Laptop","Scheda Video", "RAM",
    "Processore", "Scheda Madre", "Computer", "Tablet", "SSD", "Hard Disk"]:
        return "Informatica"
    elif prodotto in ["Mouse", "Webcam", "Tastiera", "Speaker", "Monitor", "Microfono", 
    "Caricatore", "Power Bank"]:
        return "Accessori"
    else: 
        return "Altro"

df_importato["Categoria"] = df_importato["Prodotto"].apply(assegna_categoria)
print(df_importato[["Prodotto", "Categoria"]].head())

incasso_tot_categoria = df_importato.groupby("Categoria")["Incasso"].sum()
print(incasso_tot_categoria)

quantita_media_venduta = df_importato.groupby("Categoria")["Quantità"].mean()
print(quantita_media_venduta)

